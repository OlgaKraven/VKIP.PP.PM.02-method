# Учебные параметры PostgreSQL для стенда варианта.
# Скопировать в /etc/postgresql/16/main/conf.d/00-tuning.conf
# и перезапустить: sudo systemctl restart postgresql

cluster_name              = 'lab_sql_42'

listen_addresses          = '127.0.0.1, 192.168.10.42'
port                      = 5432
max_connections           = 50
password_encryption       = scram-sha-256

shared_buffers            = 256MB
effective_cache_size      = 1GB
work_mem                  = 16MB
maintenance_work_mem      = 128MB

logging_collector         = on
log_directory             = 'log'
log_filename              = 'postgresql-%Y-%m-%d.log'
log_min_duration_statement = 1000
log_connections           = on
log_disconnections        = on
log_line_prefix           = '%m [%p] %u@%d '
